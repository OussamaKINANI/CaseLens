POSTGRES_DB=caselens
POSTGRES_USER=caselens
POSTGRES_PASSWORD=change-me

DATABASE_URL=postgresql+psycopg://caselens:change-me@localhost:5432/caselens
TEST_DATABASE_URL=postgresql+psycopg://caselens:change-me@localhost:5432/caselens_test

AI_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=120

EMBEDDING_PROVIDER=fake
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

RAG_MIN_SIMILARITY=0.32

# Signing key for reviewer access tokens.
# Generate your own before exposing the API:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-signing-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Bootstrap sign-in account, created after migrations.
# Leave the password empty to skip seeding entirely.
SEED_REVIEWER_EMAIL=reviewer@caselens.local
SEED_REVIEWER_PASSWORD=change-me-reviewer
SEED_REVIEWER_FULL_NAME=CaseLens Reviewer
SEED_REVIEWER_ROLE=administrator

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=caselens-review